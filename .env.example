# Porta da API publicada no host. O container continua na 8000.
API_PORT=8000
# Porta do site publicada no host. O container continua na 3000.
WEB_PORT=3000
# URL que o navegador usa para chamar a API. Entra no build do site.
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=postgres
# Porta do Postgres publicada no host. Dentro da rede a API usa a porta 5432.
POSTGRES_PORT=5432

# Porta do Redis publicada no host. Dentro da rede a URL é redis://redis:6379/0.
REDIS_PORT=6379
