# Porta da API publicada no host. O container continua na 8000.
API_PORT=8000
# Porta do site publicada no host. O container continua na 3000.
WEB_PORT=3000
# URL da API só para o servidor Next dentro do Compose (SSR). O navegador não chama essa origem.
NEXT_PUBLIC_API_URL=http://api:8000
# Host público da API que o navegador abre (WebSocket; o HTTP usa a mesma origem com http/https). Em produção, wss://.
NEXT_PUBLIC_WS_URL=ws://api:8000

POSTGRES_USER=postgres
# O valor é só de exemplo; em deploy público o segredo é outro.
POSTGRES_PASSWORD=1234
POSTGRES_DB=postgres
# Porta do Postgres publicada no host. Dentro da rede a API usa a porta 5432.
POSTGRES_PORT=5432

# Porta do Redis publicada no host. Dentro da rede a URL é redis://redis:6379/0.
REDIS_PORT=6379
