DOCS_PATH=/docs
REDOCS_PATH=/redocs

# Postgres ao rodar a API fora do Compose.
POSTGRES_HOST=db
POSTGRES_USER=postgres
# O valor é só de exemplo; em deploy público o segredo é outro.
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Cota: 1000/dia sem chave.
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2

# Redis ao rodar a API fora do Compose. Usado só pelo cache de cartas.
REDIS_URL=redis://redis:6379/0

# Segredo HMAC do access_token. O token leva o id do usuário e a expiração.
# O valor é só de exemplo; em deploy público o segredo é outro.
TOKEN_SECRET=ya5MHaCQz8oZVMrNM2zgKOOY54dW6IUnMfWW8ljVqeo=

# Segredo HMAC da cadeia de lances, separado do token de login.
# O valor é só de exemplo; em deploy público o segredo é outro.
AUDIT_SECRET=a7UJL/Vf+umlMvZxRvDULVMUz8Mz3p5v3jJ62FSbwOQ=
