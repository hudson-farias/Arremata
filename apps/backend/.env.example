DOCS_PATH=/docs
REDOCS_PATH=/redocs

# Postgres ao rodar a API fora do Compose.
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Cota: 1000/dia sem chave.
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2

# Redis ao rodar a API fora do Compose. Usado só pelo cache de cartas.
REDIS_URL=redis://127.0.0.1:6379/0

# Segredo HMAC do access_token. O token leva o id do usuário e a expiração.
TOKEN_SECRET=troque-esta-chave
